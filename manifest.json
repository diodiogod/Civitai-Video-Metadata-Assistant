{
  "manifest_version": 3,
  "name": "Civitai Video Metadata Assistant",
  "version": "0.6.13",
  "description": "Read generation metadata from local MP4/WebM files and fill Civitai upload prompts and resources.",
  "action": {
    "default_title": "Scan Civitai video metadata",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://civitai.com/*",
    "https://*.civitai.com/*",
    "https://civitai.red/*",
    "https://*.civitai.red/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/*",
        "https://*.civitai.com/*",
        "https://civitai.red/*",
        "https://*.civitai.red/*"
      ],
      "js": ["src/metadata.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "civitai-video-metadata-assistant@example.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
